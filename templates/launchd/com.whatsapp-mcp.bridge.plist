<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.whatsapp-mcp.bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{BRIDGE_BIN}}</string>
    </array>
    <key>WorkingDirectory</key>
    <string>{{BRIDGE_DIR}}</string>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- Webhook forwarding is off unless setup was given a consumer:
             WEBHOOK_ENABLED=false is the bridge's off switch. When
             WEBHOOK_URL is unset the bridge would POST every incoming
             message to localhost:8769, where any local process could
             listen, so the default URL is also the discard port (root-only
             to bind). -->
        <key>WEBHOOK_ENABLED</key>
        <string>{{WEBHOOK_ENABLED}}</string>
        <key>WEBHOOK_URL</key>
        <string>{{WEBHOOK_URL}}</string>
        <key>FORWARD_SELF</key>
        <string>{{FORWARD_SELF}}</string>
        <key>WHATSAPP_BRIDGE_PORT</key>
        <string>{{BRIDGE_PORT}}</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart on every exit: the bridge exits 0 when it gives up
         connecting (no network at login, a QR window that timed out), so
         restarting only after a failure leaves it down for good. -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>{{LOG_PATH}}</string>
    <key>StandardErrorPath</key>
    <string>{{LOG_PATH}}</string>
</dict>
</plist>
